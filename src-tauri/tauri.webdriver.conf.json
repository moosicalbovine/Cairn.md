{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "io.github.moosicalbovine.cairn-md-webdriver",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cairn.md",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-automation --remote-debugging-port=0 --test-type=webdriver"
      }
    ]
  }
}
