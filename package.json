{
  "name": "cairn-md",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:flows": "vitest run tests/e2e",
    "test:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test/desktop-flow.ps1",
    "test:recovery": "node --experimental-strip-types tests/performance/recovery.ts",
    "test:markdown": "vitest run src/features/editor/markdown/roundtrip.test.ts tests/e2e/editor-modes.spec.ts",
    "perf": "node --experimental-strip-types tests/performance/startup.ts",
    "perf:startup": "node --experimental-strip-types tests/performance/startup.ts",
    "release:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/validate-installer.ps1",
    "release:verify-webview2": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/verify-webview2-bootstrapper.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.4",
    "@milkdown/kit": "7.22.1",
    "@milkdown/react": "7.22.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "codemirror": "6.0.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.0.16",
    "vitest": "4.1.11"
  }
}
